# Cookie Chain RPC endpoint. Defaults to the public Cookiescan RPC.
COOKIE_RPC_URL=https://rpc.cookiescan.io

# Optional — unset means read-only mode. Base58 secret, solana-keygen JSON, or a keypair file path.
# NEVER commit a real key.
COOKIE_PRIVATE_KEY=

# Default slippage tolerance in basis points (500 = 5%).
COOKIE_SLIPPAGE_BPS=500

# Solana mainnet RPC. The public default is OK for `bridge` and reads, but `trade {chain:"solana"}`
# refuses it — set a dedicated RPC for more complex tasks (a free Helius/Shyft/QuickNode key is enough).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional Jupiter key (free tier available). Without it: lite-api.jup.ag at 0.5 req/s.
# JUPITER_API_KEY=

# The MomoSwap launchpad's create-pool Address Lookup Table (frozen, on Cookie Chain).
# Only needed to launch a token WITH a dev buy: that bundles create+buy into one transaction, which
# only fits as a versioned build over this table (momoswap-backend #112/#120). Pinned rather than read
# from the API's response — the accounts a table index resolves to are exactly what has to be verified,
# so the party that built the transaction cannot be the one that says what it means. Unset ⇒ deploy_token
# refuses a dev buy up front (launch, then launchpad_buy right after) and everything else is unaffected.
# Defaults to the published, frozen table CawUNMrsk6KwjXZ8kNPQgC1obMD4QM5oqvo3rF2bErX6 — override only
# to talk to a non-production deployment.
# MOMOSWAP_LAUNCHPAD_ALT=
